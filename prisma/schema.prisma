generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  phone        String?
  email        String   @unique
  passwordHash String
  role         String // owner | admin | seller
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Category {
  id        Int        @id @default(autoincrement())
  parentId  Int?
  nameRu    String
  nameKy    String?
  slug      String     @unique
  sort      Int        @default(0)
  isVisible Boolean    @default(true)
  products  Product[]
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id                 Int      @id @default(autoincrement())
  categoryId         Int
  brandId            Int?
  sku                String   @unique
  barcode            String?  @unique
  nameRu             String
  nameKy             String?
  slug               String   @unique
  description        String   @default("")
  attributes         Json     // kind, colors[], sizes[], specs[]
  unit               String   @default("шт.")
  salePrice          Int?
  oldPrice           Int?
  costPrice          Float    @default(0) // средневзвешенная себестоимость
  stockQty           Int      @default(0)
  reservedQty        Int      @default(0)
  minQty             Int      @default(0)
  isPublished        Boolean  @default(false)
  installmentAllowed Boolean  @default(false)
  status             String   @default("draft") // draft | awaiting_price | active | archived
  createdAt          DateTime @default(now())

  category     Category        @relation(fields: [categoryId], references: [id])
  brand        Brand?          @relation(fields: [brandId], references: [id])
  images       ProductImage[]
  movements    StockMovement[]
  receiptItems ReceiptItem[]
  orderItems   OrderItem[]
  priceHistory PriceHistory[]
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  path      String
  sort      Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Supplier {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  phone    String?
  note     String?
  receipts Receipt[]
}

model Receipt {
  id          Int           @id @default(autoincrement())
  number      String        @unique
  date        DateTime      @default(now())
  supplierId  Int?
  invoiceNo   String?
  extraCosts  Float         @default(0)
  status      String        @default("draft") // draft | posted | cancelled
  createdById Int
  postedAt    DateTime?
  supplier    Supplier?     @relation(fields: [supplierId], references: [id])
  items       ReceiptItem[]
}

model ReceiptItem {
  id            Int     @id @default(autoincrement())
  receiptId     Int
  productId     Int
  qty           Int
  purchasePrice Float
  landedCost    Float   @default(0)
  receipt       Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [productId], references: [id])
}

model StockMovement {
  id           Int      @id @default(autoincrement())
  productId    Int
  type         String // receipt | sale | return | write_off | adjustment
  qty          Int // +/-
  unitCost     Float
  documentType String?
  documentId   Int?
  userId       Int?
  note         String?
  createdAt    DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id])

  @@index([productId, createdAt])
}

model WriteOff {
  id           Int            @id @default(autoincrement())
  date         DateTime       @default(now())
  reason       String
  status       String         @default("pending") // pending | approved | rejected
  createdById  Int
  approvedById Int?
  items        WriteOffItem[]
}

model WriteOffItem {
  id         Int      @id @default(autoincrement())
  writeOffId Int
  productId  Int
  qty        Int
  writeOff   WriteOff @relation(fields: [writeOffId], references: [id], onDelete: Cascade)
}

model Customer {
  id      Int     @id @default(autoincrement())
  name    String
  phone   String  @unique
  address String?
  orders  Order[]
}

model Order {
  id            Int         @id @default(autoincrement())
  number        String      @unique
  customerId    Int?
  source        String // site | instagram | whatsapp | store
  status        String      @default("new")
  paymentMethod String // cash | qr | installment
  paymentStatus String      @default("unpaid")
  deliveryType  String      @default("pickup")
  address       String?
  total         Int
  discount      Int         @default(0)
  sellerId      Int?
  reserveUntil  DateTime?
  createdAt     DateTime    @default(now())
  shippedAt     DateTime?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  payments      Payment[]

  @@index([status, createdAt])
}

model OrderItem {
  id         Int     @id @default(autoincrement())
  orderId    Int
  productId  Int
  qty        Int
  price      Int
  discount   Int     @default(0)
  costAtSale Float   @default(0)
  meta       String? // цвет / размер
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])
}

model Payment {
  id         Int      @id @default(autoincrement())
  orderId    Int
  provider   String
  externalId String?  @unique
  amount     Int
  status     String
  rawPayload Json?
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id])
}

model PriceHistory {
  id        Int      @id @default(autoincrement())
  productId Int
  oldPrice  Int?
  newPrice  Int?
  userId    Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String
  entityId  Int?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

/// Счётчик неудачных попыток входа (общий для всех экземпляров сервера)
model LoginAttempt {
  key       String   @id
  count     Int
  firstAt   DateTime
}
